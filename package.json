{
  "name": "nasza-rodzina-web",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-nasza-rodzina \"node --test tests/security.rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-nasza-rodzina \"playwright test\"",
    "family:setup": "node scripts/bootstrap-family.mjs",
    "family:migrate": "node scripts/bootstrap-family.mjs --migrate"
  },
  "dependencies": {
    "firebase": "^12.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^15.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
