# Public Firebase web settings; copy to .env.local before building.
# Never put passwords, VULCAN credentials or service account keys in VITE_*.
VITE_FIREBASE_API_KEY=AIzaSyCXPjIYKQo94oYcHDDwJTjiDVvpAGcCB4Q
VITE_FIREBASE_AUTH_DOMAIN=nasza-rodzina.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nasza-rodzina
VITE_FIREBASE_STORAGE_BUCKET=nasza-rodzina.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=340731425852
VITE_FIREBASE_APP_ID=1:340731425852:web:c3b27185641dc190443f39
VITE_FIREBASE_MEASUREMENT_ID=G-H4YCZ9NT03

# Local development only. Use projectId demo-nasza-rodzina when true.
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1

# eduVULCAN backend: Vercel server environment ONLY; never prefix these with VITE_.
# Version 1.5.1 uses the SAME variables as 1.5.0; no new values are required.
# Parents share one family connection. Do not add user UIDs, login or password here.
# Required project ID must match the public Firebase project and the service account.
FIREBASE_PROJECT_ID=nasza-rodzina
# Set exactly ONE service account format in Vercel. Keep both empty in this template.
# Paste the downloaded Firebase service-account JSON as the entire value, OR its base64.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Generate once: 32 random bytes in base64; see docs/VULCAN.md. Never commit the result.
# Preserve the existing key when upgrading from 1.5.0; a new key invalidates sessions.
EDUVULCAN_ENCRYPTION_KEY_BASE64=
EDUVULCAN_ENCRYPTION_KEY_ID=v1
# Max inactivity retention: a verified school read AND successful guarded import renew it.
# Status checks or failed syncs never renew it; eduVULCAN may invalidate its session earlier.
# Expired envelopes become safe reconnect markers. Firestore TTL is not auto-configured.
EDUVULCAN_SESSION_TTL_HOURS=24
# Production origin only, e.g. https://your-family.vercel.app (no path).
EDUVULCAN_SITE_ORIGIN=

# Google: ten sam publiczny Web OAuth Client ID po obu stronach.
# Dodatkowa metoda dla już połączonego UID; nigdy client secret.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# OPCJONALNE: przygotowanie do przyszłego, osobno zaakceptowanego Web Push.
# Tryb IN-APP 1.6.0 nie rejestruje FCM, nie prosi o zgodę systemową i nie wymaga VAPID.
# Pole może pozostać puste; jego brak nie wyłącza dzwonka ani centrum powiadomień.
VITE_FIREBASE_VAPID_KEY=

# Istniejącego EDUVULCAN_ENCRYPTION_KEY_BASE64 nie zmieniaj ani nie rotuj.

# OPCJONALNE: osobne połączenie Google Calendar, tylko backend Vercel/Functions.
# Te same wartości klucza i OAuth w obu runtime; patrz docs/ETAP_9B_GOOGLE_SCHEDULER.md.
# Brak tych wartości nie blokuje aplikacji ani logowania Google / eduVULCAN.
# OAuth Web client musi zezwalać na calendar.readonly oraz dokładny callback:
# https://<produkcyjna-domena>/api/calendars/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_SITE_ORIGIN=
# Osobny klucz 32 bajty/base64. NIGDY nie używaj tutaj klucza eduVULCAN.
CALENDAR_ENCRYPTION_KEY_BASE64=
CALENDAR_ENCRYPTION_KEY_ID=v1
