rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data; }
    function member() {
      return signedIn() && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
        && profile().active == true && profile().canLogin == true
        && profile().get('archived', false) == false
        && profile().role in ['parent', 'adult', 'child'];
    }
    function parent() { return member() && profile().role == 'parent'; }
    function ownPerson() { return profile().personKey; }
    function image() { return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']; }
    function medicalFile() { return image() || request.resource.contentType == 'application/pdf'; }
    function healthAccess(visibility, person) {
      return member() && (person in ['family', 'Sebastian', 'Dominika', 'Paweł', 'Nikodem', 'Layla']
        || person.matches('member-[a-f0-9]{24}'))
        && (visibility == 'parents' && parent()
          || visibility == 'shared' && (parent() || person == ownPerson() || person == 'family'));
    }
    function avatarTarget(uid) {
      return firestore.get(/databases/(default)/documents/members/$(uid)).data;
    }
    function avatarEditor(uid) {
      return member()
        && firestore.exists(/databases/(default)/documents/members/$(uid))
        && avatarTarget(uid).get('active', false) == true
        && avatarTarget(uid).get('archived', false) == false
        && (uid == request.auth.uid || (parent()
          && (avatarTarget(uid).get('role', '') == 'child' || avatarTarget(uid).get('canLogin', true) == false)));
    }
    function avatarFilename(filename) {
      return filename.matches('[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}\\.(jpg|jpeg|png|webp|gif)');
    }
    match /avatars/members/{targetUid}/{uploaderUid}/{filename} {
      allow read: if member();
      allow create, update: if uploaderUid == request.auth.uid && avatarEditor(targetUid)
        && avatarFilename(filename) && request.resource.size <= 5 * 1024 * 1024 && image();
      allow delete: if avatarEditor(targetUid) && avatarFilename(filename);
    }
    match /avatars/family/{uploaderUid}/{filename} {
      allow read: if member();
      allow create, update: if parent() && uploaderUid == request.auth.uid
        && avatarFilename(filename) && request.resource.size <= 5 * 1024 * 1024 && image();
      allow delete: if parent() && avatarFilename(filename);
    }
    match /quick-products/{uid}/{filename} {
      allow read: if member();
      allow create, update: if member() && uid == request.auth.uid
        && request.resource.size <= 5 * 1024 * 1024 && image();
      allow delete: if member() && (uid == request.auth.uid || parent());
    }
    match /health/{visibility}/{person}/{uid}/{filename} {
      allow read: if healthAccess(visibility, person);
      allow create, update: if healthAccess(visibility, person) && uid == request.auth.uid
        && (parent() || person == ownPerson())
        && request.resource.size <= 10 * 1024 * 1024 && medicalFile();
      allow delete: if parent();
    }
    function taskFamilyId(value) {
      return value is string && value != '__legacy__' && value.matches('[A-Za-z0-9][A-Za-z0-9_-]{0,127}');
    }
    function taskMember() {
      return member() && profile().get('disabled', false) == false
        && taskFamilyId(profile().get('familyId', null));
    }
    function taskPerson() {
      let personKey = profile().get('personKey', '');
      return personKey is string && personKey.size() > 0 ? personKey : profile().get('name', '');
    }
    function taskUpload(filename) {
      return firestore.get(/databases/(default)/documents/_taskPhotoUploads/$(filename.split('[.]')[0])).data;
    }
    function proofFilename(filename) {
      return filename.matches('[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}\\.(jpg|png|webp)');
    }
    // Storage permits at most two distinct Firestore documents per evaluation:
    // the current member and this Admin-issued, atomically revoked upload ticket.
    function proofTicketAccess(taskId, uid, filename) {
      let ticket = taskUpload(filename);
      return taskFamilyId(ticket.get('familyId', null)) && ticket.familyId == profile().familyId
        && ticket.taskId == taskId && ticket.uid == uid
        && ticket.path == 'taskProof/' + taskId + '/' + uid + '/' + filename
        && ticket.state in ['open', 'submitted']
        && (parent() || (uid == request.auth.uid && (ticket.person == taskPerson() || ticket.person == 'family')));
    }
    function proofAccess(taskId, uid, filename) {
      return taskMember() && proofFilename(filename) && proofTicketAccess(taskId, uid, filename);
    }
    match /taskProof/{taskId}/{uid}/{filename} {
      allow read: if proofAccess(taskId, uid, filename);
      allow create: if resource == null && proofAccess(taskId, uid, filename) && uid == request.auth.uid
        && taskUpload(filename).state == 'open' && taskUpload(filename).expiresAt > request.time
        && request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024
        && request.resource.size == taskUpload(filename).size
        && request.resource.contentType == taskUpload(filename).contentType
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
    }
    function rewardImageTicket(filename) {
      return firestore.get(/databases/(default)/documents/_taskRewardImageUploads/$(filename.split('[.]')[0])).data;
    }
    function rewardImageAccess(rewardId, uid, filename) {
      let ticket = rewardImageTicket(filename);
      let rewardPerson = taskPerson();
      return taskFamilyId(ticket.get('familyId', null)) && ticket.familyId == profile().familyId
        && ticket.rewardId == rewardId && ticket.uid == uid
        && ticket.path == 'taskRewardImages/' + rewardId + '/' + uid + '/' + filename
        && (ticket.state == 'open' && parent() && uid == request.auth.uid
          || ticket.state == 'attached' && (parent()
            || (ticket.active == true && (ticket.people.size() == 0 || rewardPerson in ticket.people))));
    }
    match /taskRewardImages/{rewardId}/{uid}/{filename} {
      allow read: if taskMember() && proofFilename(filename) && rewardImageAccess(rewardId, uid, filename);
      allow create: if resource == null && taskMember() && parent() && uid == request.auth.uid
        && proofFilename(filename) && rewardImageAccess(rewardId, uid, filename)
        && rewardImageTicket(filename).state == 'open' && rewardImageTicket(filename).expiresAt > request.time
        && request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024
        && request.resource.size == rewardImageTicket(filename).size
        && request.resource.contentType == rewardImageTicket(filename).contentType
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
    }
    function medicalDocument(id) {
      return firestore.get(/databases/(default)/documents/healthDocuments/$(id)).data;
    }
    function medicalDocumentFamily(id) {
      return medicalDocument(id).get('attachmentKind', '') != 'health-record'
        || medicalDocument(id).get('familyId', null) == profile().get('familyId', null);
    }
    match /healthDocuments/{documentId}/{uploaderUid}/{filename} {
      allow read: if member() && medicalDocument(documentId).state == 'ready'
        && medicalDocumentFamily(documentId)
        && request.auth.uid in medicalDocument(documentId).readers
        && medicalDocument(documentId).storagePath == 'healthDocuments/' + documentId + '/' + uploaderUid + '/' + filename;
      allow create: if resource == null && member() && uploaderUid == request.auth.uid
        && medicalDocumentFamily(documentId)
        && medicalDocument(documentId).createdBy == request.auth.uid
        && request.auth.uid in medicalDocument(documentId).editors
        && medicalDocument(documentId).state == 'draft' && medicalDocument(documentId).uploadExpiresAt > request.time
        && medicalDocument(documentId).storagePath == 'healthDocuments/' + documentId + '/' + uploaderUid + '/' + filename
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.size == medicalDocument(documentId).size
        && request.resource.contentType == medicalDocument(documentId).mimeType
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
    }
    // Old health/person/file paths are denied. Migrate them before deploying.
    match /{path=**} { allow read, write: if false; }
  }
}
