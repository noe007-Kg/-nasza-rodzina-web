{
  "name": "nasza-rodzina-web",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-nasza-rodzina \"node --test tests/security.rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-nasza-rodzina \"playwright test\"",
    "family:setup": "node scripts/bootstrap-family.mjs",
    "family:migrate": "node scripts/bootstrap-family.mjs --migrate",
    "test:server": "node --test tests/edu-*.test.mjs tests/account-*.test.mjs tests/notification-*.test.mjs",
    "functions:prepare": "node scripts/prepare-functions.mjs",
    "pretest:server": "npm run functions:prepare",
    "test:functions": "npm --prefix functions run build && npm --prefix functions run check && node --test tests/edu-scheduler.test.mjs tests/edu-functions-package.test.mjs tests/notification-functions.test.mjs tests/functions-runtime.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "cheerio": "^1.2.0",
    "firebase": "^12.3.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^11.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-tools": "^15.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  }
}
